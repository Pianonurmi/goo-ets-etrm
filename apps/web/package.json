{
  "name": "etrm-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web UI for the GoO and EU ETS ETRM (ADR 0025)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../api/openapi/etrm-api.json --read-write-markers -o src/shared/api/schema.d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "vite build",
    "budget": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "e2e": "playwright test",
    "sbom": "cyclonedx-npm --omit dev --output-format JSON --output-file build/sbom/etrm-web.cdx.json"
  },
  "dependencies": {
    "@mantine/charts": "9.7.1",
    "@mantine/core": "9.7.1",
    "@mantine/dates": "9.7.1",
    "@mantine/form": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "@mantine/modals": "9.7.1",
    "@mantine/notifications": "9.7.1",
    "@mantine/spotlight": "9.7.1",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.1",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "dayjs": "1.11.23",
    "i18next": "26.4.3",
    "oidc-client-ts": "3.5.0",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-router": "7.18.4",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "openapi-typescript-helpers": "0.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
