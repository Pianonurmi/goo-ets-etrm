# Caddy in front of the showcase (docs/deploy/vps.md). ETRM_SITE_ADDRESS is ":80" for plain HTTP on the server's
# address, or a domain name such as demo.example.com for automatic HTTPS. Behind a Cloudflare Tunnel,
# docker-compose.tunnel.yml uses Caddyfile.tunnel instead.
{
	# The client address the application sees (sign-in throttle, logs) is the real peer; client-sent
	# X-Forwarded-For is not trusted, because no trusted_proxies are configured.
	servers {
		protocols h1 h2 h3
	}
}

{$ETRM_SITE_ADDRESS::80} {
	import site.caddy
}
