# Copy to .env, fill in, then: chmod 600 .env && docker compose up -d   (docs/deploy/vps.md)

# The database password (any long random string; only the containers use it).
POSTGRES_PASSWORD=

# The demo sign-in: user "demo" with this password (12 characters or more)...
ETRM_DEMO_PASSWORD=
# ...or several users, "user:password,user2:password2"; a value may be a {bcrypt} hash.
ETRM_DEMO_USERS=

# ":80" serves plain HTTP on the server's address (passwords travel unencrypted).
# Set a domain name pointing at this server, e.g. demo.example.com, to get HTTPS from Let's Encrypt.
ETRM_SITE_ADDRESS=:80

# The host ports Caddy listens on. Change them when 80 or 443 is already taken, e.g. ETRM_HTTP_PORT=8088 and then
# open http://<server>:8088/. HTTPS with a domain needs the standard ports.
ETRM_HTTP_PORT=80
ETRM_HTTPS_PORT=443

# The image to run: :main follows every green commit; a release pins a version (:0.9.0), :0.9 takes its patch
# releases, :latest the newest release, :<sha> one commit (docs/operations/releases.md).
ETRM_IMAGE=ghcr.io/pianonurmi/goo-ets-etrm:main
