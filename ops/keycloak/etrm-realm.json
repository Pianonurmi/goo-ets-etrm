{
  "realm": "etrm",
  "enabled": true,
  "roles": {
    "realm": [
      {"name": "TRADER"}, {"name": "MIDDLE_OFFICE"}, {"name": "BACK_OFFICE"}, {"name": "REGISTRY_OPERATOR"},
      {"name": "ACCOUNTANT"}, {"name": "RISK"}, {"name": "AUDITOR"}, {"name": "ADMIN"}
    ]
  },
  "clients": [
    {
      "clientId": "etrm-api",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8080/*", "http://localhost:5173/*"],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {"claim.name": "roles", "multivalued": "true", "access.token.claim": "true", "id.token.claim": "true", "jsonType.label": "String"}
        }
      ]
    }
  ],
  "users": [
    {"username": "trader", "enabled": true, "credentials": [{"type": "password", "value": "trader"}], "realmRoles": ["TRADER"]},
    {"username": "middle", "enabled": true, "credentials": [{"type": "password", "value": "middle"}], "realmRoles": ["MIDDLE_OFFICE"]},
    {"username": "backoffice", "enabled": true, "credentials": [{"type": "password", "value": "backoffice"}], "realmRoles": ["BACK_OFFICE", "REGISTRY_OPERATOR"]},
    {"username": "accountant", "enabled": true, "credentials": [{"type": "password", "value": "accountant"}], "realmRoles": ["ACCOUNTANT"]},
    {"username": "admin", "enabled": true, "credentials": [{"type": "password", "value": "admin"}], "realmRoles": ["ADMIN"]}
  ]
}
